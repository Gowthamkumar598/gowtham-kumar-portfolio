/* ==========================================================================
   Gowtham Kumar - Data Analyst Portfolio Stylesheet
   Theme: Dark Navy, Teal & Blue Accents, Glassmorphism, Modern Typography
   ========================================================================== */

/* --- CSS Variables & Design Tokens --- */
:root {
  /* Dark Navy Background Spectrum */
  --bg-primary: #060b19;
  --bg-secondary: #0a1329;
  --bg-card: rgba(15, 26, 54, 0.75);
  --bg-card-hover: rgba(20, 36, 75, 0.85);
  --bg-elevated: #112044;
  --bg-code: #0b152d;
  
  /* Brand Accents */
  --accent-teal: #64ffda;
  --accent-teal-hover: #52e3c2;
  --accent-teal-dim: rgba(100, 255, 218, 0.12);
  --accent-blue: #38bdf8;
  --accent-blue-deep: #0284c7;
  --accent-blue-dim: rgba(56, 189, 248, 0.12);
  --gradient-accent: linear-gradient(135deg, #64ffda 0%, #38bdf8 100%);
  --gradient-glow: linear-gradient(135deg, rgba(100, 255, 218, 0.2) 0%, rgba(56, 189, 248, 0.2) 100%);
  
  /* Text Colors */
  --text-primary: #f8fafc;
  --text-secondary: #cbd5e1;
  --text-muted: #8892b0;
  --text-code: #a5f3fc;

  /* Borders & Shadows */
  --border-subtle: rgba(56, 189, 248, 0.12);
  --border-focus: rgba(100, 255, 218, 0.45);
  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.35);
  --shadow-md: 0 10px 25px rgba(3, 8, 22, 0.6);
  --shadow-lg: 0 20px 40px rgba(2, 6, 18, 0.75);
  --shadow-glow: 0 0 35px rgba(56, 189, 248, 0.2);

  /* Typography */
  --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'Fira Code', 'JetBrains Mono', Consolas, monospace;

  /* Layout & Transitions */
  --max-width: 1200px;
  --nav-height: 80px;
  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 20px;
  --radius-full: 9999px;
}

/* --- Global Reset & Base Setup --- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-family: var(--font-main);
  background-color: var(--bg-primary);
  color: var(--text-secondary);
  scroll-behavior: smooth;
  scroll-padding-top: var(--nav-height);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  line-height: 1.65;
  background-color: var(--bg-primary);
}

::selection {
  background-color: var(--accent-teal);
  color: var(--bg-primary);
}

/* --- Ambient Background Glows & Grid --- */
.ambient-glow {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  filter: blur(100px);
  opacity: 0.25;
}

.glow-1 {
  top: -10%;
  right: -5%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, #38bdf8, transparent 70%);
}

.glow-2 {
  top: 40%;
  left: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, #64ffda, transparent 70%);
  opacity: 0.15;
}

.glow-3 {
  bottom: 5%;
  right: 15%;
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, #0284c7, transparent 70%);
  opacity: 0.2;
}

.grid-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
  background-size: 50px 50px;
  background-image: 
    linear-gradient(to right, rgba(56, 189, 248, 0.02) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(56, 189, 248, 0.02) 1px, transparent 1px);
}

/* --- Layout Containers & Common Utilities --- */
.container {
  width: 100%;
  max-width: var(--max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
  position: relative;
  z-index: 2;
}

.section {
  padding: 100px 0;
  position: relative;
}

.section-header {
  margin-bottom: 56px;
  text-align: left;
}

.section-tag {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  color: var(--accent-teal);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 8px;
  display: inline-block;
}

.section-number {
  color: var(--accent-blue);
  margin-right: 4px;
}

.section-title {
  font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  display: inline-flex;
  align-items: center;
  gap: 16px;
}

.section-line {
  height: 2px;
  width: 80px;
  background: var(--gradient-accent);
  border-radius: var(--radius-full);
  margin-top: 12px;
}

.section-subtitle {
  margin-top: 14px;
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 650px;
}

.highlight {
  color: var(--accent-teal);
  font-weight: 600;
}

.accent-dot {
  color: var(--accent-teal);
}

/* --- Glassmorphism Cards --- */
.glass-card {
  background: var(--bg-card);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
}

.glass-card:hover {
  border-color: rgba(100, 255, 218, 0.3);
  box-shadow: var(--shadow-md), 0 0 20px rgba(56, 189, 248, 0.1);
}

/* --- Buttons --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-family: var(--font-mono);
  font-size: 0.92rem;
  font-weight: 500;
  text-decoration: none;
  padding: 13px 26px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  border: 1px solid transparent;
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.btn-sm {
  padding: 9px 18px;
  font-size: 0.85rem;
}

.btn-primary {
  background: var(--gradient-accent);
  color: #060b19;
  font-weight: 700;
  box-shadow: 0 4px 18px rgba(100, 255, 218, 0.28);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(100, 255, 218, 0.42);
}

.btn-secondary {
  background: rgba(56, 189, 248, 0.1);
  color: var(--text-primary);
  border-color: rgba(56, 189, 248, 0.35);
}

.btn-secondary:hover {
  background: rgba(56, 189, 248, 0.2);
  border-color: var(--accent-blue);
  color: #fff;
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent;
  color: var(--accent-teal);
  border-color: var(--accent-teal);
}

.btn-outline:hover {
  background: var(--accent-teal-dim);
  transform: translateY(-2px);
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  border-color: transparent;
}

.btn-ghost:hover {
  color: var(--accent-teal);
}

.btn-block {
  width: 100%;
}

.btn-icon {
  width: 18px;
  height: 18px;
}

/* --- NAVIGATION BAR --- */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--nav-height);
  background: rgba(6, 11, 25, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(56, 189, 248, 0.08);
  z-index: 1000;
  transition: all var(--transition-normal);
}

.navbar.scrolled {
  box-shadow: var(--shadow-md);
  border-bottom-color: rgba(56, 189, 248, 0.2);
  height: 70px;
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 24px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.logo-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  background: rgba(100, 255, 218, 0.1);
  border: 1px solid var(--accent-teal);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--accent-teal);
  font-size: 1rem;
  letter-spacing: -0.05em;
  transition: transform var(--transition-fast);
}

.logo:hover .logo-badge {
  transform: rotate(-6deg) scale(1.05);
}

.logo-text {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.logo-sub {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--accent-blue);
  font-weight: 500;
}

.nav-menu {
  display: flex;
  align-items: center;
}

.nav-list {
  display: flex;
  align-items: center;
  gap: 28px;
  list-style: none;
}

.nav-link {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-secondary);
  text-decoration: none;
  padding: 6px 0;
  position: relative;
  transition: color var(--transition-fast);
}

.nav-number {
  color: var(--accent-teal);
  margin-right: 4px;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--gradient-accent);
  transition: width var(--transition-normal);
  border-radius: var(--radius-full);
}

.nav-link:hover, .nav-link.active {
  color: #ffffff;
}

.nav-link:hover::after, .nav-link.active::after {
  width: 100%;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.menu-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  z-index: 1010;
}

.menu-toggle .bar {
  height: 2px;
  width: 100%;
  background-color: var(--accent-teal);
  border-radius: 2px;
  transition: all var(--transition-normal);
}

.menu-toggle.active .bar:nth-child(1) {
  transform: translateY(9px) rotate(45deg);
}

.menu-toggle.active .bar:nth-child(2) {
  opacity: 0;
}

.menu-toggle.active .bar:nth-child(3) {
  transform: translateY(-9px) rotate(-45deg);
}

/* --- HERO SECTION --- */
.hero-section {
  min-height: calc(100vh - var(--nav-height));
  display: flex;
  align-items: center;
  padding-top: calc(var(--nav-height) + 40px);
  padding-bottom: 60px;
  position: relative;
}

.hero-container {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 48px;
}

.badge-status {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 16px;
  background: rgba(100, 255, 218, 0.08);
  border: 1px solid rgba(100, 255, 218, 0.25);
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--accent-teal);
  margin-bottom: 24px;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--accent-teal);
  box-shadow: 0 0 10px var(--accent-teal);
  animation: pulseAnimation 2s infinite ease-in-out;
}

@keyframes pulseAnimation {
  0% { transform: scale(0.9); opacity: 0.7; box-shadow: 0 0 0 0 rgba(100, 255, 218, 0.7); }
  70% { transform: scale(1.1); opacity: 1; box-shadow: 0 0 0 8px rgba(100, 255, 218, 0); }
  100% { transform: scale(0.9); opacity: 0.7; box-shadow: 0 0 0 0 rgba(100, 255, 218, 0); }
}

.hero-greeting {
  font-family: var(--font-mono);
  font-size: 1.05rem;
  color: var(--accent-teal);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}

.hero-title {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin-bottom: 12px;
}

.typing-container {
  font-family: var(--font-mono);
  font-size: clamp(1.2rem, 2.5vw, 1.8rem);
  color: var(--accent-blue);
  font-weight: 600;
  margin-bottom: 22px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-height: 2.2rem;
}

.typing-prefix {
  color: var(--text-muted);
  margin-right: 8px;
}

.typing-text {
  color: var(--accent-blue);
  text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
}

.typing-cursor {
  color: var(--accent-teal);
  font-weight: 300;
  margin-left: 2px;
  animation: blink 0.9s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.hero-description {
  font-size: 1.08rem;
  line-height: 1.75;
  color: var(--text-secondary);
  max-width: 580px;
  margin-bottom: 34px;
}

.hero-cta-group {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  margin-bottom: 40px;
}

.hero-metrics {
  display: flex;
  align-items: center;
  gap: 28px;
  padding-top: 24px;
  border-top: 1px solid var(--border-subtle);
  max-width: 540px;
}

.metric-item {
  display: flex;
  flex-direction: column;
}

.metric-number {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--text-primary);
  font-family: var(--font-mono);
  line-height: 1.2;
}

.metric-label {
  font-size: 0.8rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-top: 4px;
}

.metric-divider {
  width: 1px;
  height: 38px;
  background-color: var(--border-subtle);
}

/* --- Hero Visual & Profile Card --- */
.hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.visual-wrapper {
  position: relative;
  width: 100%;
  max-width: 420px;
}

.orbital-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 380px;
  height: 380px;
  background: radial-gradient(circle, rgba(100, 255, 218, 0.15) 0%, rgba(56, 189, 248, 0.08) 60%, transparent 80%);
  border-radius: 50%;
  filter: blur(25px);
  pointer-events: none;
}

.orbital-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  border: 1px dashed rgba(56, 189, 248, 0.25);
  pointer-events: none;
  transform: translate(-50%, -50%);
}

.orbital-ring-1 {
  width: 440px;
  height: 440px;
  animation: spinSlow 30s linear infinite;
}

.orbital-ring-2 {
  width: 360px;
  height: 360px;
  border-color: rgba(100, 255, 218, 0.2);
  animation: spinSlow 24s linear infinite reverse;
}

@keyframes spinSlow {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.profile-card {
  position: relative;
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-lg), 0 0 40px rgba(56, 189, 248, 0.12);
  transition: transform var(--transition-normal);
}

.profile-card:hover {
  transform: translateY(-4px);
  border-color: rgba(100, 255, 218, 0.4);
}

.profile-avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.profile-avatar-svg {
  width: 100%;
  max-width: 290px;
  height: auto;
  filter: drop-shadow(0 15px 25px rgba(0, 0, 0, 0.5));
}

.avatar-photo-caption {
  margin-top: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--accent-teal);
  background: rgba(10, 20, 45, 0.8);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  border: 1px solid rgba(100, 255, 218, 0.2);
}

.caption-icon {
  font-size: 0.9rem;
}

/* Floating Tech Badges */
.floating-badge {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: rgba(13, 25, 53, 0.9);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--text-primary);
  box-shadow: var(--shadow-md);
  z-index: 5;
  pointer-events: auto;
  transition: all var(--transition-fast);
}

.floating-badge:hover {
  transform: scale(1.08) translateY(-2px);
  border-color: var(--accent-teal);
  box-shadow: 0 8px 20px rgba(100, 255, 218, 0.25);
}

.badge-icon {
  display: flex;
  align-items: center;
  color: var(--accent-teal);
}

.badge-sql {
  top: 10%;
  left: -20px;
  animation: floatSlow 6s ease-in-out infinite;
}

.badge-powerbi {
  top: 15%;
  right: -25px;
  animation: floatSlow 5.5s ease-in-out 1s infinite;
}

.badge-python {
  bottom: 22%;
  left: -28px;
  animation: floatSlow 6.5s ease-in-out 2s infinite;
}

.badge-excel {
  bottom: 12%;
  right: -20px;
  animation: floatSlow 5.8s ease-in-out 1.5s infinite;
}

@keyframes floatSlow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* --- ABOUT SECTION --- */
.about-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 48px;
  align-items: start;
}

.lead-text {
  font-size: 1.15rem;
  color: var(--text-primary);
  line-height: 1.8;
  margin-bottom: 20px;
}

.about-text-column p {
  margin-bottom: 18px;
  color: var(--text-secondary);
}

.about-principles {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 32px;
}

.principle-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 18px;
  background: rgba(15, 26, 54, 0.5);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.principle-card:hover {
  background: rgba(20, 36, 75, 0.7);
  border-color: rgba(56, 189, 248, 0.3);
  transform: translateX(4px);
}

.principle-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  min-width: 42px;
  background: rgba(56, 189, 248, 0.1);
  border-radius: var(--radius-sm);
  color: var(--accent-blue);
}

.principle-icon svg {
  width: 22px;
  height: 22px;
}

.principle-card h4 {
  font-size: 1rem;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.principle-card p {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 0;
  line-height: 1.5;
}

/* JSON Code Card in About */
.profile-details-card {
  padding: 0;
  overflow: hidden;
  border-color: rgba(56, 189, 248, 0.2);
}

.card-top-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 18px;
  background: rgba(8, 14, 32, 0.8);
  border-bottom: 1px solid var(--border-subtle);
}

.card-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.card-dot.red { background-color: #ef4444; }
.card-dot.yellow { background-color: #f59e0b; }
.card-dot.green { background-color: #10b981; }

.card-title-sm {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-left: 8px;
}

.card-code-content {
  padding: 22px;
  background: var(--bg-code);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.6;
  overflow-x: auto;
}

.card-code-content pre {
  margin: 0;
}

.json-key { color: var(--accent-blue); }
.json-str { color: var(--accent-teal); }
.json-num { color: #f472b6; }

.card-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: rgba(10, 18, 40, 0.7);
  border-top: 1px solid var(--border-subtle);
}

/* --- TECHNICAL SKILLS SECTION --- */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.skill-card {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 28px;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.skill-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: var(--gradient-accent);
  opacity: 0;
  transition: opacity var(--transition-normal);
}

.skill-card:hover {
  transform: translateY(-6px);
  border-color: rgba(100, 255, 218, 0.35);
  box-shadow: var(--shadow-md), 0 0 24px rgba(56, 189, 248, 0.15);
}

.skill-card:hover::before {
  opacity: 1;
}

.skill-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.skill-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  background: rgba(56, 189, 248, 0.1);
  color: var(--accent-blue);
  transition: transform var(--transition-fast);
}

.skill-card:hover .skill-icon-box {
  transform: scale(1.1);
}

.skill-icon-box svg {
  width: 24px;
  height: 24px;
}

.sql-theme { background: rgba(56, 189, 248, 0.12); color: #38bdf8; }
.python-theme { background: rgba(250, 204, 21, 0.12); color: #facc15; }
.excel-theme { background: rgba(34, 197, 94, 0.12); color: #22c55e; }
.powerbi-theme { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
.html-theme { background: rgba(239, 68, 68, 0.12); color: #f87171; }
.css-theme { background: rgba(96, 165, 250, 0.12); color: #60a5fa; }

.skill-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-muted);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.skill-name {
  font-size: 1.28rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.skill-desc {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 22px;
  flex-grow: 1;
}

.skill-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.topic-chip {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  padding: 4px 10px;
  background: rgba(10, 18, 40, 0.8);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--accent-teal);
  transition: all var(--transition-fast);
}

.topic-chip:hover {
  background: var(--accent-teal-dim);
  border-color: var(--accent-teal);
}

/* --- PROJECTS SECTION --- */
.project-filters {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.filter-btn {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  padding: 8px 18px;
  border-radius: var(--radius-full);
  background: rgba(15, 26, 54, 0.6);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.filter-btn:hover {
  color: #fff;
  border-color: var(--accent-blue);
}

.filter-btn.active {
  background: var(--accent-teal);
  color: #060b19;
  font-weight: 700;
  border-color: var(--accent-teal);
  box-shadow: 0 4px 14px rgba(100, 255, 218, 0.3);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
}

.project-card {
  background: var(--bg-card);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-normal);
}

.project-card:hover {
  transform: translateY(-8px);
  border-color: rgba(56, 189, 248, 0.4);
  box-shadow: var(--shadow-lg), 0 0 30px rgba(56, 189, 248, 0.15);
}

.project-card-banner {
  height: 190px;
  position: relative;
  background: #081125;
  overflow: hidden;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
}

.project-type-pill {
  position: absolute;
  top: 14px;
  right: 14px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 4px 10px;
  background: rgba(6, 11, 25, 0.85);
  border: 1px solid rgba(100, 255, 218, 0.3);
  border-radius: var(--radius-full);
  color: var(--accent-teal);
  z-index: 5;
}

/* Custom banner illustrations */
.project-banner-art {
  width: 90%;
  height: 85%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Power BI Banner Art */
.powerbi-art {
  flex-direction: column;
  justify-content: space-around;
  background: rgba(12, 22, 48, 0.7);
  border: 1px solid rgba(56, 189, 248, 0.15);
  border-radius: var(--radius-sm);
  padding: 12px;
}

.art-kpi-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

.art-kpi {
  display: flex;
  flex-direction: column;
}

.kpi-mini-label {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  color: var(--text-muted);
}

.kpi-mini-val {
  font-size: 0.88rem;
  font-family: var(--font-mono);
  font-weight: 700;
  color: #fff;
}

.text-teal { color: var(--accent-teal); }

.art-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  width: 100%;
  height: 60px;
  gap: 8px;
  padding-top: 10px;
  border-bottom: 1px dashed rgba(56, 189, 248, 0.2);
}

.art-bar {
  flex: 1;
  background: rgba(56, 189, 248, 0.3);
  border-radius: 3px 3px 0 0;
  transition: all var(--transition-fast);
}

.active-bar {
  background: var(--gradient-accent);
  box-shadow: 0 0 10px rgba(100, 255, 218, 0.4);
}

/* Python Banner Art */
.python-art {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-art-window {
  width: 92%;
  padding: 14px;
  background: #09132b;
  border: 1px solid rgba(56, 189, 248, 0.18);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  line-height: 1.6;
}

.code-art-line {
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.c-kw { color: #f472b6; font-weight: 600; }
.c-str { color: var(--accent-teal); }
.c-fn { color: var(--accent-blue); }

/* SQL Banner Art */
.sql-art {
  width: 92%;
  height: 85%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sql-table-mock {
  width: 100%;
  background: #09132b;
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: var(--radius-sm);
  overflow: hidden;
  font-family: var(--font-mono);
  font-size: 0.72rem;
}

.table-row-mock {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  padding: 8px 12px;
  border-bottom: 1px solid rgba(56, 189, 248, 0.08);
  color: var(--text-secondary);
}

.table-row-mock:last-child {
  border-bottom: none;
}

.table-row-mock.header-row {
  background: rgba(56, 189, 248, 0.12);
  color: var(--accent-teal);
  font-weight: 600;
}

/* Web Banner Art */
.web-art {
  width: 90%;
  height: 85%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.browser-mock {
  width: 100%;
  height: 100%;
  background: #09132b;
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.browser-bar {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 10px;
  background: rgba(14, 26, 56, 0.8);
  border-bottom: 1px solid rgba(56, 189, 248, 0.1);
}

.browser-bar span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.browser-body {
  padding: 10px;
  flex: 1;
}

.mock-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  height: 100%;
}

.mock-card {
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.15);
  border-radius: 4px;
}

/* Project Body */
.project-body {
  padding: 26px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.project-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.project-year {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--accent-teal);
}

.project-status {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 2px 8px;
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
  border-radius: var(--radius-full);
}

.project-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
  line-height: 1.35;
}

.project-description {
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.65;
  margin-bottom: 20px;
  flex-grow: 1;
}

.project-tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}

.tech-pill {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--accent-blue);
  background: var(--accent-blue-dim);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(56, 189, 248, 0.2);
}

.project-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid var(--border-subtle);
}

/* --- EDUCATION SECTION --- */
.education-container {
  max-width: 900px;
  margin: 0 auto;
}

.timeline-card {
  display: flex;
  gap: 28px;
  background: var(--bg-card);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: var(--radius-lg);
  padding: 36px;
  box-shadow: var(--shadow-md);
  position: relative;
}

.timeline-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  min-width: 58px;
  border-radius: var(--radius-md);
  background: var(--gradient-accent);
  color: #060b19;
  box-shadow: 0 4px 20px rgba(100, 255, 218, 0.35);
}

.timeline-badge svg {
  width: 30px;
  height: 30px;
}

.timeline-content {
  flex: 1;
}

.timeline-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.degree-badge {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--accent-teal);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
  display: inline-block;
}

.degree-title {
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 2px;
}

.degree-major {
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--accent-blue);
}

.timeline-date-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background: rgba(10, 18, 40, 0.8);
  border: 1px solid var(--border-subtle);
  padding: 8px 16px;
  border-radius: var(--radius-sm);
}

.grad-label {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  color: var(--text-muted);
}

.grad-year {
  font-size: 1.25rem;
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--accent-teal);
}

.institution-meta {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  margin-bottom: 24px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--border-subtle);
}

.institution-name, .institution-location {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.95rem;
  color: var(--text-secondary);
}

.institution-name svg, .institution-location svg {
  color: var(--accent-blue);
}

.coursework-section {
  margin-bottom: 24px;
}

.coursework-heading {
  font-size: 0.9rem;
  font-family: var(--font-mono);
  color: var(--text-primary);
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.coursework-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.coursework-tag {
  font-size: 0.82rem;
  padding: 5px 12px;
  background: rgba(56, 189, 248, 0.08);
  border: 1px solid rgba(56, 189, 248, 0.18);
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  transition: all var(--transition-fast);
}

.coursework-tag:hover {
  border-color: var(--accent-teal);
  color: var(--accent-teal);
  background: var(--accent-teal-dim);
}

.education-highlights {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 18px;
}

.edu-highlight-box {
  padding: 16px;
  background: rgba(10, 18, 42, 0.6);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
}

.highlight-num {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--accent-teal);
  display: block;
  margin-bottom: 6px;
}

.edu-highlight-box p {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
}

.edu-highlight-box strong {
  color: var(--text-primary);
}

/* --- RESUME SECTION --- */
.resume-wrapper {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  max-width: 950px;
  margin: 0 auto;
}

.resume-card-glow {
  position: absolute;
  top: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 80%;
  height: 200%;
  background: radial-gradient(circle, rgba(100, 255, 218, 0.18) 0%, rgba(56, 189, 248, 0.08) 50%, transparent 70%);
  pointer-events: none;
  filter: blur(40px);
}

.resume-content-box {
  position: relative;
  background: rgba(15, 26, 54, 0.8);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(100, 255, 218, 0.3);
  border-radius: var(--radius-lg);
  padding: 48px;
  display: flex;
  align-items: center;
  gap: 36px;
  box-shadow: var(--shadow-lg), 0 0 35px rgba(100, 255, 218, 0.12);
}

.resume-icon-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  min-width: 72px;
  border-radius: 50%;
  background: rgba(100, 255, 218, 0.12);
  border: 1px solid var(--accent-teal);
  color: var(--accent-teal);
}

.resume-icon-circle svg {
  width: 36px;
  height: 36px;
}

.resume-text {
  flex: 1;
}

.resume-label {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--accent-teal);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  display: block;
  margin-bottom: 6px;
}

.resume-title {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10px;
}

.resume-desc {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.resume-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 220px;
}

/* --- CONTACT SECTION --- */
.contact-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 48px;
  align-items: start;
}

.contact-info-col {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.info-card {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 20px;
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.info-card:hover {
  border-color: var(--accent-blue);
  transform: translateX(4px);
  background: rgba(20, 36, 75, 0.7);
}

.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  border-radius: var(--radius-sm);
  background: rgba(56, 189, 248, 0.1);
  color: var(--accent-blue);
}

.info-icon svg {
  width: 22px;
  height: 22px;
}

.info-text {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.info-title {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 2px;
}

.info-link {
  font-size: 0.95rem;
  color: var(--text-primary);
  text-decoration: none;
  word-break: break-all;
  transition: color var(--transition-fast);
}

.info-link:hover {
  color: var(--accent-teal);
}

.info-link.plain {
  cursor: default;
}

/* Contact Form */
.contact-form-card {
  padding: 34px;
  border-color: rgba(56, 189, 248, 0.2);
}

.form-group {
  margin-bottom: 22px;
  display: flex;
  flex-direction: column;
}

.form-label {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.required {
  color: #f43f5e;
}

.form-input {
  width: 100%;
  padding: 13px 16px;
  background: rgba(8, 14, 32, 0.8);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  font-family: var(--font-main);
  font-size: 0.95rem;
  color: var(--text-primary);
  outline: none;
  transition: all var(--transition-fast);
}

.form-input:focus {
  border-color: var(--accent-teal);
  box-shadow: 0 0 0 3px rgba(100, 255, 218, 0.15);
  background: rgba(10, 18, 42, 0.95);
}

.form-input::placeholder {
  color: rgba(148, 163, 184, 0.45);
}

.form-textarea {
  resize: vertical;
  min-height: 120px;
}

.error-msg {
  display: none;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: #f87171;
  margin-top: 6px;
}

.form-group.has-error .form-input {
  border-color: #ef4444;
}

.form-group.has-error .error-msg {
  display: block;
}

.form-feedback {
  margin-top: 18px;
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  display: none;
}

.form-feedback.success {
  display: block;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid #10b981;
  color: #34d399;
}

.form-feedback.error {
  display: block;
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  color: #f87171;
}

/* --- FOOTER --- */
.footer {
  background: #040813;
  border-top: 1px solid rgba(56, 189, 248, 0.1);
  padding: 48px 0;
  position: relative;
  z-index: 2;
}

.footer-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 28px;
}

.footer-logo {
  margin-bottom: 8px;
}

.footer-tagline {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.footer-nav {
  display: flex;
  align-items: center;
  gap: 20px;
  list-style: none;
}

.footer-nav a {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer-nav a:hover {
  color: var(--accent-teal);
}

.footer-right {
  text-align: right;
}

.copyright {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.built-with {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--accent-blue);
  margin-top: 4px;
}

/* --- SCROLL TO TOP BUTTON --- */
.scroll-top-btn {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 44px;
  height: 44px;
  border-radius: var(--radius-sm);
  background: rgba(15, 26, 54, 0.9);
  backdrop-filter: blur(8px);
  border: 1px solid var(--border-subtle);
  color: var(--accent-teal);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 99;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-fast);
  box-shadow: var(--shadow-md);
}

.scroll-top-btn.visible {
  opacity: 1;
  visibility: visible;
}

.scroll-top-btn:hover {
  background: var(--accent-teal);
  color: #060b19;
  transform: translateY(-4px);
  box-shadow: 0 6px 18px rgba(100, 255, 218, 0.35);
}

.scroll-top-btn svg {
  width: 20px;
  height: 20px;
}

/* --- MODALS (Project & Resume) --- */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(4, 7, 18, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-box {
  background: #0b152d;
  border: 1px solid rgba(56, 189, 248, 0.25);
  border-radius: var(--radius-md);
  width: 100%;
  max-width: 820px;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: var(--shadow-lg), 0 0 40px rgba(56, 189, 248, 0.2);
  transform: translateY(20px) scale(0.96);
  transition: transform var(--transition-normal);
}

.modal-overlay.active .modal-box {
  transform: translateY(0) scale(1);
}

.modal-close-btn {
  position: absolute;
  top: 18px;
  right: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--text-secondary);
  font-size: 1.6rem;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
  z-index: 10;
}

.modal-close-btn:hover {
  background: rgba(239, 68, 68, 0.2);
  border-color: #ef4444;
  color: #ef4444;
}

.modal-content {
  padding: 36px;
}

/* Modal Content Inner Styling */
.modal-project-header {
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border-subtle);
}

.modal-project-tag {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--accent-teal);
  text-transform: uppercase;
  margin-bottom: 6px;
  display: block;
}

.modal-project-title {
  font-size: 1.65rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.3;
}

.modal-section-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--accent-blue);
  margin-top: 24px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-body-text {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 14px;
}

.modal-bullet-list {
  padding-left: 20px;
  color: var(--text-secondary);
  margin-bottom: 20px;
}

.modal-bullet-list li {
  margin-bottom: 8px;
  font-size: 0.93rem;
  line-height: 1.6;
}

.modal-bullet-list strong {
  color: var(--text-primary);
}

.modal-code-block {
  background: #060c1d;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 16px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--text-code);
  overflow-x: auto;
  margin: 16px 0;
  line-height: 1.5;
}

/* --- RESUME PREVIEW MODAL & PRINT STYLES --- */
.resume-modal-box {
  max-width: 860px;
  background: #0f1c3a;
}

.modal-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 28px;
  background: #081126;
  border-bottom: 1px solid var(--border-subtle);
  position: sticky;
  top: 0;
  z-index: 10;
}

.modal-header-bar h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.resume-sheet {
  background: #ffffff;
  color: #1e293b;
  padding: 44px;
  margin: 24px;
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  font-family: var(--font-main);
  line-height: 1.5;
}

.resume-sheet-header {
  text-align: center;
  margin-bottom: 24px;
}

.resume-sheet-header h1 {
  font-size: 1.85rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #0f172a;
  margin-bottom: 4px;
}

.resume-sheet-subtitle {
  font-size: 0.95rem;
  font-weight: 600;
  color: #0284c7;
  margin-bottom: 8px;
}

.resume-sheet-contact {
  font-size: 0.82rem;
  color: #475569;
}

.resume-sheet-section {
  margin-bottom: 20px;
}

.sheet-section-title {
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #0f172a;
  text-transform: uppercase;
}

.sheet-divider {
  height: 2px;
  background-color: #0284c7;
  margin: 4px 0 10px 0;
}

.sheet-text {
  font-size: 0.88rem;
  color: #334155;
  line-height: 1.6;
}

.sheet-item {
  margin-bottom: 14px;
}

.sheet-item-header {
  display: flex;
  justify-content: space-between;
  font-size: 0.92rem;
  color: #0f172a;
  margin-bottom: 2px;
}

.sheet-item-sub {
  font-size: 0.86rem;
  color: #0284c7;
  font-weight: 600;
  margin-bottom: 4px;
}

.sheet-item-detail {
  font-size: 0.85rem;
  color: #475569;
}

.sheet-list, .sheet-bullet-list {
  padding-left: 20px;
  font-size: 0.86rem;
  color: #334155;
}

.sheet-list li, .sheet-bullet-list li {
  margin-bottom: 5px;
  line-height: 1.5;
}

.sheet-list strong, .sheet-bullet-list strong {
  color: #0f172a;
}

/* Print Media Query */
@media print {
  body * {
    visibility: hidden;
  }
  #printableResumeArea, #printableResumeArea * {
    visibility: visible;
  }
  #printableResumeArea {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    margin: 0;
    padding: 20px;
    box-shadow: none;
    border: none;
  }
}

/* --- RESPONSIVE MEDIA QUERIES --- */
@media (max-width: 1024px) {
  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 56px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .typing-container {
    justify-content: center;
  }

  .hero-cta-group {
    justify-content: center;
  }

  .hero-metrics {
    justify-content: center;
  }

  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .education-highlights {
    grid-template-columns: 1fr;
  }

  .resume-content-box {
    flex-direction: column;
    text-align: center;
    padding: 36px 24px;
  }

  .resume-actions {
    width: 100%;
  }

  .contact-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }
}

@media (max-width: 768px) {
  :root {
    --nav-height: 70px;
  }

  .menu-toggle {
    display: flex;
  }

  .nav-menu {
    position: fixed;
    top: var(--nav-height);
    left: -100%;
    width: 100%;
    height: calc(100vh - var(--nav-height));
    background: rgba(6, 11, 25, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    flex-direction: column;
    justify-content: flex-start;
    padding: 40px 24px;
    transition: left var(--transition-normal);
    border-top: 1px solid var(--border-subtle);
  }

  .nav-menu.active {
    left: 0;
  }

  .nav-list {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 100%;
  }

  .nav-link {
    font-size: 1.1rem;
    width: 100%;
    display: block;
    padding: 8px 0;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .timeline-card {
    flex-direction: column;
    gap: 20px;
    padding: 24px;
  }

  .timeline-badge {
    width: 48px;
    height: 48px;
    min-width: 48px;
  }

  .timeline-date-box {
    align-items: flex-start;
    margin-top: 8px;
  }

  .footer-container {
    flex-direction: column;
    text-align: center;
    gap: 24px;
  }

  .footer-right {
    text-align: center;
  }

  .floating-badge {
    display: none; /* Hide floating badges on narrow mobile for cleanliness */
  }

  .resume-sheet {
    padding: 24px 18px;
    margin: 12px;
  }

  .modal-content {
    padding: 24px 18px;
  }
}

@media (max-width: 480px) {
  .skills-grid {
    grid-template-columns: 1fr;
  }

  .hero-metrics {
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }

  .metric-divider {
    display: none;
  }

  .hero-cta-group {
    flex-direction: column;
    width: 100%;
  }

  .hero-cta-group .btn {
    width: 100%;
  }
}
